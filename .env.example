# Application environment variables
# Copy this file to .env.local and update values as needed.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# Supabase — required when using Supabase clients (Milestone 3+)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for admin user provisioning (Milestone 19+)
# Use the legacy "service_role" JWT key from Supabase Dashboard → Settings → API
# (not the sb_secret_ publishable/secret pair unless your project uses only those)
SUPABASE_SERVICE_ROLE_KEY=
